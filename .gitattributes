# Text files are stored and checked out with LF line endings on every platform,
# whatever core.autocrlf is set to (Windows Git sets it to true).
* text=auto eol=lf

# Shell scripts must always be checked out with LF line endings so they run
# correctly under bash (including WSL and Docker on Windows), regardless of core.autocrlf.
*.sh text eol=lf

*.pdf binary

# build/ is generated by CI; leave its line endings as the postprocessor writes them.
build/** -text
