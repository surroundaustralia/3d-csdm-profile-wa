# Normalize line endings to LF for all text files. This repo is worked on
# from both native Windows tools and WSL; without this, files round-trip
# between LF (as committed) and CRLF, producing whole-file line-ending diffs.
* text=auto eol=lf

# build/ is regenerated by the BBlocks CI; keep its line endings exactly as
# the generator writes them, or the next CI build flips them back.
build/** -text

# Explicit binary formats.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pyc binary
