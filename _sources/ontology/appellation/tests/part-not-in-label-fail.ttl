# A Crown Allotment appellation whose number part ("58") does not appear in the appellation label.
@prefix com: <https://w3id.org/ogc/utils/label/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix wa: <https://linked.data.gov.au/def/csdm/profiles/wa/> .
@prefix wa-name-part-type: <https://linked.data.gov.au/def/csdm/wa-name-part-type/> .

[] a wa:CrownAllotmentAppellation ;
  rdfs:label "Albany Town Lot 57" ;
  dct:hasPart [ com:namePartType wa-name-part-type:number ; rdfs:label "58" ] .
