{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Liminal 3D cases profile of Cadastral Survey Data Model",
  "x-jsonld-context": "context.jsonld",
  "allOf": [
    {
      "$ref": "bblocks://icsm.profiles.wa.wa-core"
    },
    {
      "properties": {
        "parcels": {
          "type": "array",
          "items": {
            "properties": {
              "features": {
                "type": "array",
                "items": {
                  "properties": {
                    "properties": {
                      "required": [
                        "spatialRepresentationDefinitions"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
