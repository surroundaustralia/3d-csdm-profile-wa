{"defs":{"0":[{"path":["definitionRef"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/definitionRef","jsonld_type":"@id","description":"Identifier of the entry in `verticalBoundaryDefinitions` that establishes this boundary, when `state` indicates a source definition exists.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/definitionRef"},{"path":["geometryRef"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/geometryRef","jsonld_type":"@id","description":"Identifier of the derived boundary geometry (e.g. an upper or lower surface) realising this boundary, when `state` is derived.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/geometryRef"},{"path":["state"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/boundaryState","jsonld_type":"@vocab","description":"The state of this boundary: undefined, not applicable, unconstrained, defined but unresolved, defined, or derived. A vocabulary-referencing value (e.g. `vertical-boundary-state:und`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/boundaryState"}]},"properties":[{"path":["representationStatus"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/representationStatus","jsonld_type":"@vocab","description":"How the feature's spatial representation currently stands: 2D footprint only, 2.5D (footprint plus reference surface), height-described, jurisdictionally bounded, or derived 3D. A vocabulary-referencing value (e.g. `representation-status:2d`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/representationStatus"},{"path":["geometryLegalStatus"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/geometryLegalStatus","jsonld_type":"@vocab","description":"Which geometry is legally authoritative for the feature: the 2D footprint, an observed surface, or geometry derived from a legal description. A vocabulary-referencing value (e.g. `geometry-legal-status:a2d`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/geometryLegalStatus"},{"path":["coordinateRepresentation"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/coordinateRepresentation","jsonld_type":"@id","required":true,"sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/coordinateRepresentation"},{"path":["coordinateRepresentation","coordinateDimension"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/coordinateDimension","jsonld_type":"http://www.w3.org/2001/XMLSchema#integer","description":"The number of ordinates carried by the feature's coordinates.","required":true,"schema_type":"integer","enum":[2,3],"sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/coordinateDimension"},{"path":["coordinateRepresentation","zValueRole"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/zValueRole","jsonld_type":"@vocab","description":"What a third coordinate ordinate, if present, means: absent, a contextual geometry height, a reference-surface height, or a derived-boundary height. A vocabulary-referencing value (e.g. `coordinate-z-role:absent`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/zValueRole"},{"path":["verticalExtent"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/verticalExtent","jsonld_type":"@id","required":true,"sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/verticalExtent"},{"path":["verticalExtent","status"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/verticalExtentStatus","jsonld_type":"@vocab","description":"The overall legal or source state of the vertical extent. A vocabulary-referencing value (e.g. `vertical-extent-status:ud`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/verticalExtentStatus"},{"path":["verticalExtent","lowerBoundary"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/lowerBoundary","jsonld_type":"@id","required":true,"sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"ref":"0","effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/lowerBoundary"},{"path":["verticalExtent","upperBoundary"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/upperBoundary","jsonld_type":"@id","required":true,"sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"ref":"0","effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/upperBoundary"},{"path":["verticalExtent","sourceReference"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/sourceReference","jsonld_type":"@id","description":"Identifier of the supporting source document, where the extent's status (e.g. a positively established unconstrained extent) is itself sourced.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/sourceReference"},{"path":["computabilityStatus"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/computabilityStatus","jsonld_type":"@vocab","description":"Whether coordinate boundaries or geometry can be calculated from the information currently available. A vocabulary-referencing value (e.g. `computability-status:nc`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/computabilityStatus"},{"path":["verticalBoundaryDefinitions"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/verticalBoundaryDefinitions","jsonld_type":"@id","description":"The source definitions (relative offset, absolute datum value, or jurisdictional rule) that establish or describe a vertical boundary. Kept separate from any computed/derived geometry \u2014 see `derivedGeometry`.","schema_type":"array","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition","bblocks://icsm.profiles.wa.datatypes.parcelSpatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/verticalBoundaryDefinitions"},{"path":["verticalBoundaryDefinitions","id"],"description":"Local identifier for this definition, referenced by `verticalExtent.lowerBoundary.definitionRef` / `upperBoundary.definitionRef` and by `derivedGeometry.inputDefinitionRefs`.","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"]},{"path":["verticalBoundaryDefinitions","definitionType"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/definitionType","jsonld_type":"@vocab","description":"The kind of source definition: relative height description, absolute height description, jurisdictional boundary rule, or geometry boundary reference. A vocabulary-referencing value (e.g. `vertical-definition-type:rel`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/definitionType"},{"path":["verticalBoundaryDefinitions","limitRole"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/limitRole","jsonld_type":"@vocab","description":"Whether this definition establishes an upper or lower limit. A vocabulary-referencing value (e.g. `vertical-limit-role:ll`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/limitRole"},{"path":["verticalBoundaryDefinitions","valueType"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/valueType","jsonld_type":"@vocab","description":"How `value` is expressed: as an offset from a reference, or as an absolute height/depth. A vocabulary-referencing value (e.g. `vertical-value-type:off`).","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/valueType"},{"path":["verticalBoundaryDefinitions","value"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/value","jsonld_type":"http://www.w3.org/2001/XMLSchema#decimal","description":"The numeric height, depth, or offset value.","schema_type":"number","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/value"},{"path":["verticalBoundaryDefinitions","direction"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/direction","jsonld_type":"@vocab","description":"The direction in which `value` is expressed (above or below the reference), where relevant. A vocabulary-referencing value (e.g. `vertical-direction:blw`).","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/direction"},{"path":["verticalBoundaryDefinitions","heightReference"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/heightReference","jsonld_type":"@vocab","description":"The surface, level, object, plane or datum that `value` is relative to. A vocabulary-referencing value (e.g. `height-reference:gl`).","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/heightReference"},{"path":["verticalBoundaryDefinitions","description"],"id":"http://purl.org/dc/terms/description","description":"Human-readable description or verbatim source wording for this boundary definition.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["verticalBoundaryDefinitions","comparisonOperator"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/comparisonOperator","description":"The comparison implied by an absolute value, e.g. `lessThanOrEqual` or `greaterThanOrEqual`.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/comparisonOperator"},{"path":["verticalBoundaryDefinitions","resolutionStatus"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/resolutionStatus","description":"Whether this definition has been resolved into a computable absolute value, e.g. `requiresReferenceSurface`, `absoluteLimitAvailable`, or `resolved`.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/resolutionStatus"},{"path":["verticalBoundaryDefinitions","sourceReference"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/sourceReference","jsonld_type":"@id","description":"Identifier of the supporting source document for this definition.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/sourceReference"},{"path":["verticalBoundaryDefinitions","provenanceRef"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/provenanceRef","jsonld_type":"@id","description":"Identifier of the PROV activity that extracted or derived this definition.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/provenanceRef"},{"path":["referenceSurfaces"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/referenceSurfaces","jsonld_type":"@id","description":"Reference surfaces (terrain, ground, floor, or other surface) that provide vertical context for the feature. A reference surface supports analysis or visualisation; it is not by itself a legal vertical boundary.","schema_type":"array","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/referenceSurfaces"},{"path":["referenceSurfaces","id"],"description":"Local identifier for this reference surface, referenced by `derivedGeometry.inputSurfaceRefs`.","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"]},{"path":["referenceSurfaces","surfaceType"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/surfaceType","jsonld_type":"@vocab","description":"What the surface represents, e.g. ground level. A vocabulary-referencing value (e.g. `height-reference:gl`).","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/surfaceType"},{"path":["referenceSurfaces","geometryLegalStatus"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/geometryLegalStatus","jsonld_type":"@vocab","description":"The legal/analytical status of the surface geometry itself. A vocabulary-referencing value (e.g. `geometry-legal-status:obs`).","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/geometryLegalStatus"},{"path":["referenceSurfaces","ref"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/surfaceGeometryRef","jsonld_type":"@id","description":"Reference to the surface's geometry, e.g. a surface feature collection identifier.","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/surfaceGeometryRef"},{"path":["referenceSurfaces","boundedByFootprint"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/boundedByFootprint","jsonld_type":"http://www.w3.org/2001/XMLSchema#boolean","description":"Whether the surface is bounded by (contains) the feature's 2D footprint.","schema_type":"boolean","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/boundedByFootprint"},{"path":["derivedGeometry"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/derivedGeometry","jsonld_type":"@id","required":true,"sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/derivedGeometry"},{"path":["derivedGeometry","status"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/derivedGeometryStatus","description":"Whether derived geometry has been generated, e.g. `notGenerated` or `solidGenerated`.","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/derivedGeometryStatus"},{"path":["derivedGeometry","geometryType"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/geometryType","description":"The type of derived geometry produced, e.g. `Solid`.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/geometryType"},{"path":["derivedGeometry","solidRef"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/solidRef","jsonld_type":"@id","description":"Reference to the generated solid geometry.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/solidRef"},{"path":["derivedGeometry","inputFootprintRef"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/inputFootprintRef","jsonld_type":"@id","description":"Reference to the 2D footprint used as an input to the derivation.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/inputFootprintRef"},{"path":["derivedGeometry","inputDefinitionRefs"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/inputDefinitionRefs","jsonld_type":"@id","description":"References to the `verticalBoundaryDefinitions` entries used as inputs to the derivation.","schema_type":"array","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/inputDefinitionRefs"},{"path":["derivedGeometry","inputSurfaceRefs"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/inputSurfaceRefs","jsonld_type":"@id","description":"References to the `referenceSurfaces` entries used as inputs to the derivation.","schema_type":"array","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/inputSurfaceRefs"},{"path":["derivedGeometry","sourceReference"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/sourceReference","jsonld_type":"@id","description":"Identifier(s) of the supporting source document(s) for the derivation.","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/sourceReference"},{"path":["derivedGeometry","provenanceRef"],"id":"https://linked.data.gov.au/def/csdm/spatial-representation/provenanceRef","jsonld_type":"@id","description":"Identifier of the PROV activity that generated this derived geometry.","schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.spatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/spatial-representation/provenanceRef"},{"path":["verticalBoundaryDefinitions","sourceBasis"],"id":"https://linked.data.gov.au/def/csdm/parcel-vertical-boundary/sourceBasis","jsonld_type":"@id","sources":["bblocks://icsm.profiles.wa.datatypes.parcelSpatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/parcel-vertical-boundary/sourceBasis"},{"path":["verticalBoundaryDefinitions","sourceBasis","ruleType"],"id":"https://linked.data.gov.au/def/csdm/parcel-vertical-boundary/ruleType","jsonld_type":"http://www.w3.org/2001/XMLSchema#string","description":"The specific kind of jurisdictional rule applied, e.g. `crownGrantDepthLimit`.","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.parcelSpatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/parcel-vertical-boundary/ruleType"},{"path":["verticalBoundaryDefinitions","sourceBasis","sourceAuthorityType"],"id":"https://linked.data.gov.au/def/csdm/parcel-vertical-boundary/sourceAuthorityType","jsonld_type":"http://www.w3.org/2001/XMLSchema#string","description":"The type of authority or instrument the rule derives from, e.g. `CrownGrant` or `CrownGrantCondition`.","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.parcelSpatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/parcel-vertical-boundary/sourceAuthorityType"},{"path":["verticalBoundaryDefinitions","sourceBasis","sourceStatement"],"id":"https://linked.data.gov.au/def/csdm/parcel-vertical-boundary/sourceStatement","jsonld_type":"http://www.w3.org/2001/XMLSchema#string","description":"The verbatim source wording the boundary rule was extracted from, e.g. \"LIMITED IN DEPTH TO 12.19 METRES BELOW GROUND\".","required":true,"schema_type":"string","sources":["bblocks://icsm.profiles.wa.datatypes.parcelSpatialRepresentationDefinition"],"effectiveId":"https://linked.data.gov.au/def/csdm/parcel-vertical-boundary/sourceStatement"}]}