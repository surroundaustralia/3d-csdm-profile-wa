@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sr: <https://linked.data.gov.au/def/csdm/spatial-representation/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sr:boundaryState a owl:ObjectProperty ;
    rdfs:label "boundary state" ;
    rdfs:domain sr:VerticalBoundary ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "The state of a vertical boundary: undefined, not applicable, unconstrained, defined but unresolved, defined, or derived." .

sr:boundedByFootprint a owl:DatatypeProperty ;
    rdfs:label "bounded by footprint" ;
    rdfs:domain sr:ReferenceSurface ;
    rdfs:isDefinedBy sr: ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether a reference surface is bounded by (contains) the feature's 2D footprint." .

sr:comparisonOperator a owl:DatatypeProperty ;
    rdfs:label "comparison operator" ;
    rdfs:domain sr:VerticalBoundaryDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range xsd:string ;
    skos:definition "The comparison implied by an absolute boundary value, e.g. lessThanOrEqual or greaterThanOrEqual." .

sr:computabilityStatus a owl:ObjectProperty ;
    rdfs:label "computability status" ;
    rdfs:domain sr:SpatialRepresentationDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "Whether coordinate boundaries or geometry can be calculated from the information currently available." .

sr:coordinateDimension a owl:DatatypeProperty ;
    rdfs:label "coordinate dimension" ;
    rdfs:domain sr:CoordinateRepresentation ;
    rdfs:isDefinedBy sr: ;
    rdfs:range xsd:integer ;
    skos:definition "The number of ordinates carried by a feature's coordinates (2 or 3)." .

sr:coordinateRepresentation a owl:ObjectProperty ;
    rdfs:label "coordinate representation" ;
    rdfs:domain sr:SpatialRepresentationDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:CoordinateRepresentation ;
    skos:definition "Links a spatial representation definition to its coordinate representation." .

sr:definitionRef a owl:ObjectProperty ;
    rdfs:label "definition reference" ;
    rdfs:domain sr:VerticalBoundary ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:VerticalBoundaryDefinition ;
    skos:definition "References the vertical boundary definition that establishes a vertical boundary." .

sr:definitionType a owl:ObjectProperty ;
    rdfs:label "definition type" ;
    rdfs:domain sr:VerticalBoundaryDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "The kind of source definition: relative height description, absolute height description, jurisdictional boundary rule, or geometry boundary reference." .

sr:derivedGeometry a owl:ObjectProperty ;
    rdfs:label "derived geometry" ;
    rdfs:domain sr:SpatialRepresentationDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:DerivedGeometry ;
    skos:definition "Links a spatial representation definition to its derived geometry, if any has been generated." .

sr:derivedGeometryStatus a owl:DatatypeProperty ;
    rdfs:label "derived geometry status" ;
    rdfs:domain sr:DerivedGeometry ;
    rdfs:isDefinedBy sr: ;
    rdfs:range xsd:string ;
    skos:definition "Whether derived geometry has been generated, e.g. notGenerated or solidGenerated." .

sr:direction a owl:ObjectProperty ;
    rdfs:label "direction" ;
    rdfs:domain sr:VerticalBoundaryDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "The direction (above or below the reference) in which a boundary definition's value is expressed." .

sr:geometryLegalStatus a owl:ObjectProperty ;
    rdfs:label "geometry legal status" ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "Which geometry is legally authoritative for a feature." .

sr:geometryRef a owl:ObjectProperty ;
    rdfs:label "geometry reference" ;
    rdfs:domain sr:VerticalBoundary ;
    rdfs:isDefinedBy sr: ;
    skos:definition "References the derived boundary geometry (e.g. an upper or lower surface) realising a vertical boundary." .

sr:geometryType a owl:DatatypeProperty ;
    rdfs:label "geometry type" ;
    rdfs:domain sr:DerivedGeometry ;
    rdfs:isDefinedBy sr: ;
    rdfs:range xsd:string ;
    skos:definition "The type of derived geometry produced, e.g. Solid." .

sr:heightReference a owl:ObjectProperty ;
    rdfs:label "height reference" ;
    rdfs:domain sr:VerticalBoundaryDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "The surface, level, object, plane or datum that a boundary definition's value is relative to." .

sr:inputDefinitionRefs a owl:ObjectProperty ;
    rdfs:label "input definition references" ;
    rdfs:domain sr:DerivedGeometry ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:VerticalBoundaryDefinition ;
    skos:definition "References the vertical boundary definitions used as inputs to a derivation." .

sr:inputFootprintRef a owl:ObjectProperty ;
    rdfs:label "input footprint reference" ;
    rdfs:domain sr:DerivedGeometry ;
    rdfs:isDefinedBy sr: ;
    skos:definition "References the 2D footprint used as an input to a derivation." .

sr:inputSurfaceRefs a owl:ObjectProperty ;
    rdfs:label "input surface references" ;
    rdfs:domain sr:DerivedGeometry ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:ReferenceSurface ;
    skos:definition "References the reference surfaces used as inputs to a derivation." .

sr:limitRole a owl:ObjectProperty ;
    rdfs:label "limit role" ;
    rdfs:domain sr:VerticalBoundaryDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "Whether a definition establishes an upper or lower limit." .

sr:lowerBoundary a owl:ObjectProperty ;
    rdfs:label "lower boundary" ;
    rdfs:domain sr:VerticalExtent ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:VerticalBoundary ;
    skos:definition "The lower vertical boundary of a vertical extent." .

sr:provenanceRef a owl:ObjectProperty ;
    rdfs:label "provenance reference" ;
    rdfs:isDefinedBy sr: ;
    rdfs:range prov:Activity ;
    skos:definition "References the PROV activity that extracted, resolved or derived this element." .

sr:referenceSurfaces a owl:ObjectProperty ;
    rdfs:label "reference surfaces" ;
    rdfs:domain sr:SpatialRepresentationDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:ReferenceSurface ;
    skos:definition "The reference surfaces providing vertical context for a feature." .

sr:representationStatus a owl:ObjectProperty ;
    rdfs:label "representation status" ;
    rdfs:domain sr:SpatialRepresentationDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "How a feature's spatial representation currently stands, e.g. 2D footprint, 2.5D, height-described, jurisdictionally bounded, or derived 3D." .

sr:resolutionStatus a owl:DatatypeProperty ;
    rdfs:label "resolution status" ;
    rdfs:domain sr:VerticalBoundaryDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range xsd:string ;
    skos:definition "Whether a boundary definition has been resolved into a computable absolute value." .

sr:solidRef a owl:ObjectProperty ;
    rdfs:label "solid reference" ;
    rdfs:domain sr:DerivedGeometry ;
    rdfs:isDefinedBy sr: ;
    skos:definition "References the generated solid geometry of a derived geometry result." .

sr:sourceReference a owl:ObjectProperty ;
    rdfs:label "source reference" ;
    rdfs:isDefinedBy sr: ;
    rdfs:range prov:Entity ;
    skos:definition "References a supporting source document." .

sr:surfaceGeometryRef a owl:ObjectProperty ;
    rdfs:label "surface geometry reference" ;
    rdfs:domain sr:ReferenceSurface ;
    rdfs:isDefinedBy sr: ;
    skos:definition "References the geometry (e.g. a surface feature collection) realising a reference surface." .

sr:surfaceType a owl:ObjectProperty ;
    rdfs:label "surface type" ;
    rdfs:domain sr:ReferenceSurface ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "What a reference surface represents, e.g. ground level. Drawn from the same external vocabulary as sr:heightReference, but recorded as a distinct property because it classifies the surface itself rather than a boundary definition's relative position." .

sr:upperBoundary a owl:ObjectProperty ;
    rdfs:label "upper boundary" ;
    rdfs:domain sr:VerticalExtent ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:VerticalBoundary ;
    skos:definition "The upper vertical boundary of a vertical extent." .

sr:value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    rdfs:domain sr:VerticalBoundaryDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range xsd:decimal ;
    skos:definition "The numeric height, depth, or offset value of a vertical boundary definition." .

sr:valueType a owl:ObjectProperty ;
    rdfs:label "value type" ;
    rdfs:domain sr:VerticalBoundaryDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "How a boundary definition's value is expressed: as an offset from a reference, or as an absolute height/depth." .

sr:verticalBoundaryDefinitions a owl:ObjectProperty ;
    rdfs:label "vertical boundary definitions" ;
    rdfs:domain sr:SpatialRepresentationDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:VerticalBoundaryDefinition ;
    skos:definition "The source definitions of a feature's vertical boundaries." .

sr:verticalExtent a owl:ObjectProperty ;
    rdfs:label "vertical extent" ;
    rdfs:domain sr:SpatialRepresentationDefinition ;
    rdfs:isDefinedBy sr: ;
    rdfs:range sr:VerticalExtent ;
    skos:definition "Links a spatial representation definition to its vertical extent." .

sr:verticalExtentStatus a owl:ObjectProperty ;
    rdfs:label "vertical extent status" ;
    rdfs:domain sr:VerticalExtent ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "The overall legal or source state of a vertical extent." .

sr:zValueRole a owl:ObjectProperty ;
    rdfs:label "z value role" ;
    rdfs:domain sr:CoordinateRepresentation ;
    rdfs:isDefinedBy sr: ;
    rdfs:range skos:Concept ;
    skos:definition "What a third coordinate ordinate, if present, means." .

sr:CoordinateRepresentation a owl:Class ;
    rdfs:label "Coordinate Representation" ;
    rdfs:isDefinedBy sr: ;
    skos:definition "Describes the dimensionality of a feature's stored coordinates, kept separate from the feature's legal dimensionality." .

sr:VerticalExtent a owl:Class ;
    rdfs:label "Vertical Extent" ;
    rdfs:isDefinedBy sr: ;
    skos:definition "The overall legal or source state of a feature's vertical extent, together with its lower and upper boundaries." .

sr:ReferenceSurface a owl:Class ;
    rdfs:label "Reference Surface" ;
    rdfs:isDefinedBy sr: ;
    skos:definition "A terrain, ground, floor, or other surface providing vertical context for a feature. Supporting geometry only; not by itself a legal vertical boundary." .

sr:VerticalBoundary a owl:Class ;
    rdfs:label "Vertical Boundary" ;
    rdfs:isDefinedBy sr: ;
    skos:definition "The state of one direction (lower or upper) of a feature's vertical extent." .

sr:DerivedGeometry a owl:Class ;
    rdfs:label "Derived Geometry" ;
    rdfs:isDefinedBy sr: ;
    skos:definition "The computational result, if any, of converting sufficient source information into derived geometry such as a closed 3D solid." .

sr:SpatialRepresentationDefinition a owl:Class ;
    rdfs:label "Spatial Representation Definition" ;
    rdfs:isDefinedBy sr: ;
    skos:definition "The set of properties recording how a 2D feature's geometry is currently interpreted with respect to the vertical dimension." .

sr:VerticalBoundaryDefinition a owl:Class ;
    rdfs:label "Vertical Boundary Definition" ;
    rdfs:isDefinedBy sr: ;
    skos:definition "A single source definition of a vertical boundary: a relative offset, an absolute datum value, a jurisdictional rule, or a geometry boundary reference." .

sr: a owl:Ontology ;
    dct:description "Classes and properties describing how a 2D feature's geometry is interpreted with respect to the vertical dimension: representation and computability status, coordinate dimensionality, vertical extent and boundaries, the source definitions of those boundaries, supporting reference surfaces, and any derived geometry. Deliberately generic across feature types (not parcel-specific). Vocabulary value (codelist/SKOS concept scheme) definitions for the *Status, *Role, *Type, direction and zValueRole properties below are managed as a separate artefact and are out of scope for this ontology." ;
    dct:source <https://github.com/surroundaustralia/3d-csdm-profile-wa/blob/main/proposals/development/2-5d-liminal/2-5d-liminal-overview.md> ;
    dct:title "Spatial Representation Definition Vocabulary" ;
    owl:versionInfo "0.1" .

