@prefix com: <https://w3id.org/ogc/utils/label/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wa: <https://linked.data.gov.au/def/csdm/profiles/wa/> .

wa:CrownAllotmentAppellation a owl:Class ;
    rdfs:label "Crown Allotment Appellation" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/csdm/profiles/wa> ;
    rdfs:subClassOf wa:ParcelAppellation ;
    skos:definition "A legacy parcel appellation in the Crown Allotment form, supported where it is the authoritative legal description." .

wa:LotOnPlanAppellation a owl:Class ;
    rdfs:label "Lot on Plan Appellation" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/csdm/profiles/wa> ;
    rdfs:subClassOf wa:ParcelAppellation ;
    skos:definition "A parcel appellation in the Lot on Survey/Plan form. New parcels should normally use this form." .

wa:MiscellaneousTenureAppellation a owl:Class ;
    rdfs:label "Miscellaneous Tenure Appellation" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/csdm/profiles/wa> ;
    rdfs:subClassOf wa:ParcelAppellation ;
    skos:definition "A legacy parcel appellation in the Miscellaneous form, supported where it is the authoritative legal description." .

wa:ParcelAppellation a owl:Class ;
    rdfs:label "Parcel Appellation" ;
    rdfs:isDefinedBy <https://linked.data.gov.au/def/csdm/profiles/wa> ;
    rdfs:subClassOf com:CompoundName ;
    skos:definition "A parcel identifier based on the Landgate parcel identifier model, classified as Lot on Survey/Plan, Crown Allotment, or Miscellaneous." .

<https://linked.data.gov.au/def/csdm/profiles/wa> a owl:Ontology ;
    rdfs:label "WA Parcel Appellation Ontology" ;
    dct:description "Classes for the Landgate parcel identifier (appellation) forms used by the WA profile of the 3D CSDM. Each appellation is a compound name whose parts are typed with the WA name part types." ;
    owl:imports <https://w3id.org/ogc/utils/label> .

