PREFIX : <https://linked.data.gov.au/def/csdm/wa-annotation/>
PREFIX cs: <https://linked.data.gov.au/def/csdm/wa-annotation>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX termtype: <https://linked.data.gov.au/def/csdm/termtypes/>
PREFIX unggim: <https://linked.data.gov.au/def/unggim-themes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Local supplement to the published WA CSD Annotation vocabulary.
# TEMPORARY: remove once these terms are registered in
# https://icsm-au.github.io/icsm-vocabs/vocabs/LandParcels/CSD-Header/wa-annotation.ttl

:r-4
    a
        skos:Concept ,
        termtype:Annotation ;
    skos:definition "Survey carried out under Regulation 4 Compiled Plan, Transfer of Land (Surveys) Regulations 1955" ;
    skos:inScheme cs: ;
    skos:notation "r-4" ;
    skos:prefLabel "Regulation 4 Compiled Plan" ;
    skos:topConceptOf cs: ;
.

:height-limit-description
    a skos:Concept , termtype:Annotation ;
    skos:definition "Plan annotation stating a vertical limit relative to a height reference" ;
    skos:inScheme cs: ;
    skos:notation "height-limit-description" ;
    skos:prefLabel "Height limit description" ;
    skos:topConceptOf cs: ;
.

:r-54
    a
        skos:Concept ,
        termtype:Annotation ;
    skos:definition "Survey carried out in accordance with Regulation 54 of the Licensed Surveyors (General Surveying Practice) Regulations 1961" ;
    skos:inScheme cs: ;
    skos:notation "r-54" ;
    skos:prefLabel "Regulation 54 Survey Certificate" ;
    skos:topConceptOf cs: ;
.

:boundary-definition-statement
    a
        skos:Concept ,
        termtype:Annotation ;
    skos:definition "Plan annotation stating the rules by which the boundaries of the lots or part lots shown on the plan are defined, including the building or structure surfaces to which those boundaries are taken" ;
    skos:inScheme cs: ;
    skos:notation "boundary-definition-statement" ;
    skos:prefLabel "Boundary definition statement" ;
    skos:topConceptOf cs: ;
.

:licensed-valuer-certification
    a
        skos:Concept ,
        termtype:Annotation ;
    skos:definition "Plan annotation recording certification of a schedule of unit entitlements by a licensed valuer, including the valuer's name, licence number and date of certification" ;
    skos:inScheme cs: ;
    skos:notation "licensed-valuer-certification" ;
    skos:prefLabel "Licensed valuer certification" ;
    skos:topConceptOf cs: ;
.

:building-approval-certification
    a
        skos:Concept ,
        termtype:Annotation ;
    skos:definition "Plan annotation recording the issue of a building approval certificate under section 52 of the Building Act 2011, including the certificate identifier, the extent of building certified, the issuing building surveyor and local government, and the date of issue" ;
    skos:inScheme cs: ;
    skos:notation "building-approval-certification" ;
    skos:prefLabel "Building approval certification" ;
    skos:topConceptOf cs: ;
.

:strata-plan-endorsement
    a
        skos:Concept ,
        termtype:Annotation ;
    skos:definition "Plan annotation recording endorsement of a strata plan by a local government under section 15(4) of the Strata Titles Act 1985, including the local government reference and the date of endorsement" ;
    skos:inScheme cs: ;
    skos:notation "strata-plan-endorsement" ;
    skos:prefLabel "Strata plan endorsement" ;
    skos:topConceptOf cs: ;
.

:record-of-strata-titles-scheme
    a
        skos:Concept ,
        termtype:Annotation ;
    skos:definition "Plan annotation recording endorsement by the Registrar of Titles of the documents forming the record of the strata titles scheme, such as scheme by-laws and scheme notices, including the document references and the date of endorsement" ;
    skos:inScheme cs: ;
    skos:notation "record-of-strata-titles-scheme" ;
    skos:prefLabel "Record of strata titles scheme" ;
    skos:topConceptOf cs: ;
.
