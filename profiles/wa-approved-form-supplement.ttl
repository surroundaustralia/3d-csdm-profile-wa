PREFIX unggim: <https://linked.data.gov.au/def/unggim-themes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

cs:
    a skos:ConceptScheme ;
    skos:prefLabel "WA Approved Form" ;
    skos:definition "Versions of Landgate-approved forms used in Western Australian survey and strata lodgements. Each form is linked by dcterms:type to the document type it is a version of." ;
    skos:hasTopConcept
        :2021-47738 ,
        :BA14 ,
        :2020-27588-v3 ,
        :15c ;
    schema:status <https://linked.data.gov.au/def/reg-statuses/experimental> ;
.

:2021-47738
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "The approved Schedule of Unit Entitlements form." ;
    skos:inScheme cs: ;
    skos:notation "2021-47738" ;
    skos:prefLabel "Approved Schedule of Unit Entitlements Form number 2021-47738" ;
    skos:topConceptOf cs: ;
    dcterms:type doctype:scheme-ue ;
    dcterms:valid "2021-07-07/.." ;
    dcterms:source <https://www.legislation.wa.gov.au/legislation/prod/filestore.nsf/FileURL/$FILE/mrdoc_48587.pdf> ;
    skos:scopeNote "Approved under section 37, Schedule 2A clause 21T(1)(d) and Schedule 2A clause 31E(1)(c) of the Strata Titles Act 1985." ;
.

:BA14
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "The approved Building Approval Certificate form." ;
    skos:inScheme cs: ;
    skos:notation "BA14" ;
    skos:prefLabel "Approved Building Approval Certificate form BA14" ;
    skos:topConceptOf cs: ;
    dcterms:type doctype:building-approval-certificate ;
    dcterms:valid "2020-03-09/.." ;
    dcterms:source <https://www.legislation.wa.gov.au/legislation/prod/filestore.nsf/FileURL/$FILE/mrdoc_49441.pdf> ;
    skos:scopeNote "Approved under section 51, 52, 61, of the Building Act 2011 and Regulation 4 of the Building Regulations 2012." ;
.

:2020-27588-v3
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "The approved Record of Strata Title Scheme: Limitations, Interests, Encumbrances and Notifications form." ;
    skos:inScheme cs: ;
    skos:notation "2020-27588-v3" ;
    skos:prefLabel "Approved Record of Strata Title Scheme: 2020-27588-v3" ;
    skos:topConceptOf cs: ;
    dcterms:type doctype:scheme-record-form ;
    dcterms:valid "2020-07-01/.." ;
.

:15c
    a
        skos:Concept ,
        termtype:DocType ;
    skos:altLabel "15C" ;
    skos:definition "The approved form of the certificate of unconditional approval and endorsement of a built-strata or survey-strata plan under section 15(4) of the Strata Titles Act 1985, issued by the Western Australian Planning Commission (WAPC) or its authorised delegate." ;
    skos:inScheme cs: ;
    skos:notation "15c" ;
    skos:prefLabel "Strata Plan Endorsement Certificate Form 15C" ;
    skos:scopeNote "Strata subdivision approval under section 15 may first be granted subject to conditions. Development approval and building certification are separate decisions, commonly made by the local government." ;
    skos:topConceptOf cs: ;
    dcterms:type doctype:strata-plan-endorsement-certificate ;
    dcterms:valid "1980-05-06/.." ;
.
