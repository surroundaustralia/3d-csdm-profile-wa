PREFIX : <https://linked.data.gov.au/def/csdm/wa-surveypoint-purpose/>
PREFIX cs: <https://linked.data.gov.au/def/csdm/wa-surveypoint-purpose>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX surv: <https://linked.data.gov.au/def/csdm/surveyfeatures/>
PREFIX unggim: <https://linked.data.gov.au/def/unggim-themes/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

:derived-boundary
    a
        skos:Concept ,
        surv:SurveyPointPurpose ;
    skos:altLabel "derived boundary" ;
    skos:definition "Boundary mark derived from a parcels spatial representation definition" ;
    skos:inScheme cs: ;
    skos:notation "derived-boundary" ;
    skos:prefLabel "Derived 3D Boundary" ;
    skos:topConceptOf cs: ;
.
