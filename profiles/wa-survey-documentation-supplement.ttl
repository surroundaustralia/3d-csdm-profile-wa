PREFIX : <https://linked.data.gov.au/def/csdm/wa-survey-documentation-type/>
PREFIX cs: <https://linked.data.gov.au/def/csdm/wa-survey-documentation-type>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX termtype: <https://linked.data.gov.au/def/csdm/termtypes/>
PREFIX unggim: <https://linked.data.gov.au/def/unggim-themes/>
PREFIX wa-interest-type: <https://linked.data.gov.au/def/csdm/wa-interest-type/>
PREFIX wa-survey-type: <https://linked.data.gov.au/def/csdm/wa-survey-type/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Local supplement to the published WA Survey Documentation vocabulary.
# A Schedule of Unit Entitlement is the published :scheme-ue, a Record of
# Strata Titles Scheme is :scheme-record-form, and a built strata plan is a
# :2d-plan or :3d-plan with survey type wa-survey-type:strata-plan.

:csd
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "A Cadastral Survey Dataset (CSD) prepared for lodgement with Landgate to meet the requirements of regulation 3 of the Transfer of Land (Surveys) Regulations 1995." ;
    skos:inScheme cs: ;
    skos:notation "csd" ;
    skos:prefLabel "Cadastral Survey Dataset" ;
    skos:related
        :3d-plan ,
        wa-survey-type:csd ;
    skos:topConceptOf cs: ;
.

:certificate-of-title
    a
        skos:Concept ,
        termtype:DocType ;
    skos:definition "An official document issued by an appropriate jurisdictional authority identifying the owner(s) of real property along with any encumbrances over the property." ;
    skos:inScheme cs: ;
    skos:notation "certificate-of-title" ;
    skos:prefLabel "Certificate of Title" ;
    skos:related wa-interest-type:ct ;
    skos:topConceptOf cs: ;
.

:building-approval-certificate
    a
        skos:Concept ,
        termtype:DocType ;
    skos:altLabel "buildingApprovalCertificate" ;
    skos:definition "An official document that confirms a building or completed structure complies with applicable building standards and regulations." ;
    skos:inScheme cs: ;
    skos:notation "building-approval-certificate" ;
    skos:prefLabel "Building Approval Certificate" ;
    skos:topConceptOf cs: ;
.

:strata-plan-endorsement-certificate
    a
        skos:Concept ,
        termtype:DocType ;
    skos:altLabel "strataPlanEndorsementCertificate" ;
    skos:definition "A certificate of unconditional approval and endorsement of a built-strata or survey-strata plan, issued under section 15(4) of the Strata Titles Act 1985 by the Western Australian Planning Commission (WAPC) or its authorised delegate, that permits registration of the plan by Landgate." ;
    skos:inScheme cs: ;
    skos:notation "strata-plan-endorsement-certificate" ;
    skos:prefLabel "Strata Plan Endorsement Certificate" ;
    skos:scopeNote "Strata subdivision approval under section 15 may first be granted subject to conditions. Development approval and building certification are separate decisions, commonly made by the local government." ;
    skos:topConceptOf cs: ;
.

:scheme-by-laws
    a
        skos:Concept ,
        termtype:DocType ;
    skos:altLabel "schemeByLaws" ;
    skos:broader :scheme-form ;
    skos:definition "The legally binding rules that govern how residents, owners, and visitors use and share property within a strata titles scheme in Western Australia." ;
    skos:inScheme cs: ;
    skos:notation "scheme-by-laws" ;
    skos:prefLabel "Strata Titles Scheme: By-laws" ;
.

:scheme-notice
    a
        skos:Concept ,
        termtype:DocType ;
    skos:altLabel "schemeNotices" ;
    skos:broader :scheme-form ;
    skos:definition "A notice lodged with the Registrar of Titles under the Strata Titles Act 1985 that records or changes information about a strata titles scheme, and forms part of the record of the strata titles scheme." ;
    skos:inScheme cs: ;
    skos:notation "scheme-notice" ;
    skos:prefLabel "Strata Titles Scheme: Notice" ;
.
