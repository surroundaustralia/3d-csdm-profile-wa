:subdivision-t-sts
    a
        skos:Concept ,
        surv:SurveyPurpose ;
    skos:definition "Survey Cadastral Dataset prepared to support termination of a Strata Title Scheme in accordance with Part 12 of the Strata Title Act 1985" ;
    skos:inScheme cs: ;
    skos:notation "subdivision-t-sts" ;
    skos:prefLabel "Subdivision: Termination of a Strata Title Scheme" ;
    skos:topConceptOf cs: ;
.
