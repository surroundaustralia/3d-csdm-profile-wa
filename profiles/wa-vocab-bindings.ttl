@prefix container: <https://linked.data.gov.au/def/csdm/container/> .
@prefix parcel: <https://w3id.org/ogc/ladm/parcels/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix surv: <https://linked.data.gov.au/def/csdm/surveyfeatures/> .
@prefix termtype: <https://linked.data.gov.au/def/csdm/termtypes/> .
@prefix vocabs: <https://linked.data.gov.au/def/csdm/> .

prof:hasRole a qb:CodedProperty ;
    qb:codeList vocabs:wa-annotation,
        vocabs:wa-survey-documentation-type ;
    rdfs:range termtype:Annotation,
        termtype:DocType .

sosa:usedProcedure a qb:CodedProperty ;
    qb:codeList vocabs:wa-procedure-used ;
    rdfs:range sosa:Procedure ;
    sh:targetClass sosa:ObservationCollection .

container:adminUnit a qb:CodedProperty ;
    qb:codeList vocabs:wa-local-government,
        vocabs:wa-locality ;
    rdfs:range termtype:AdminUnit .

container:horizontalCRS a qb:CodedProperty ;
    qb:codeList <http://www.opengis.net/def/crs/EPSG/0>,
        vocabs:wa-crs ;
    rdfs:range termtype:AllowableCoordinateReferenceSystem ;
    sh:targetClass container:CSD .

container:purpose a qb:CodedProperty ;
    qb:codeList vocabs:wa-survey-purpose ;
    rdfs:range surv:SurveyPurpose ;
    sh:targetClass container:CSD .

container:surveyType a qb:CodedProperty ;
    qb:codeList vocabs:wa-survey-type ;
    rdfs:range termtype:SurveyType ;
    sh:targetClass container:CSD .

container:verticalDatum a qb:CodedProperty ;
    qb:codeList vocabs:wa-vhd ;
    rdfs:range termtype:AllowableCoordinateReferenceSystem ;
    sh:targetClass container:CSD .

surv:condition a qb:CodedProperty ;
    qb:codeList vocabs:wa-monument-condition ;
    rdfs:range surv:ConditionCode .

surv:form a qb:CodedProperty ;
    qb:codeList vocabs:wa-monument-form ;
    rdfs:range surv:MonumentForm .

surv:purpose a qb:CodedProperty ;
    qb:codeList vocabs:wa-surveypoint-purpose ;
    rdfs:range surv:SurveyPointPurpose ;
    sh:targetClass surv:BoundaryMark,
        surv:CadastralMark,
        surv:GeodeticReferenceMark,
        surv:SurveyPoint .

surv:state a qb:CodedProperty ;
    qb:codeList vocabs:wa-monument-state ;
    rdfs:range surv:SurveyPointState .

surv:vectorPurpose a qb:CodedProperty ;
    qb:codeList vocabs:wa-vector-purpose ;
    rdfs:range termtype:VectorPurpose .

parcel:interestType a qb:CodedProperty ;
    qb:codeList vocabs:wa-interest-type,
        vocabs:wa-secondary-purpose ;
    rdfs:range surv:InterestType,
        termtype:ParcelPurpose .

parcel:purpose a qb:CodedProperty ;
    qb:codeList vocabs:wa-parcel-purpose,
        vocabs:wa-secondary-parcel-purpose ;
    rdfs:range termtype:ParcelPurpose ;
    sh:targetClass parcel:PrimaryParcel,
        parcel:SecondaryParcel .

parcel:state a qb:CodedProperty ;
    qb:codeList vocabs:wa-parcel-state ;
    rdfs:range termtype:ParcelState ;
    sh:targetClass parcel:PrimaryParcel,
        parcel:SecondaryParcel .

parcel:statuteLink a qb:CodedProperty ;
    qb:codeList vocabs:wa-interest-type ;
    rdfs:range surv:InterestType .

parcel:type a qb:CodedProperty ;
    qb:codeList vocabs:wa-parcel-type,
        vocabs:wa-secondary-parcel-type ;
    rdfs:range surv:ParcelType ;
    sh:targetClass parcel:PrimaryParcel,
        parcel:SecondaryParcel .

